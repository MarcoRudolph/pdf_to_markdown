# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cache
.cache
.eslintcache
.turbo
.swc

# Python API: local environments, caches and generated artifacts
/API/.venv/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
.coverage*
htmlcov/
/API/*.pdf
/API/*.markdown
/API/document.md
/API/tests/*.pdf
/API/tests/*.md

# Local secrets and task workspace (keep example templates tracked)
.env.*
!.env.example
.superpowers/

# Rollback snapshots of external project sources (must not go public)
/pdf_to_markdown/styleguide/drafts/rollback/
